rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsScore(uid) {
      return signedIn() && request.auth.uid == uid && request.resource.data.uid == uid;
    }

    function allowedBoard(board) {
      return board in ['scores', 'scores_world_1_1', 'scores_world_1_2'];
    }

    function validScore() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'name',
        'scope',
        'score',
        'coins',
        'world',
        'updatedAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 20
      && request.resource.data.scope is string
      && request.resource.data.score is int
      && request.resource.data.score >= 0
      && request.resource.data.coins is int
      && request.resource.data.coins >= 0
      && request.resource.data.world is string
      && request.resource.data.world.size() <= 20;
    }

    match /{board}/{uid} {
      allow read: if allowedBoard(board);
      allow create: if allowedBoard(board)
        && request.resource.data.scope == board
        && ownsScore(uid)
        && validScore();
      allow update: if allowedBoard(board)
        && request.resource.data.scope == board
        && ownsScore(uid)
        && validScore()
        && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }
  }
}
